{
  "title": "PMK.DEV",
  "description": "A safe space for clankers and tokens",
  "site": {
    "url": "https://pmk.dev/",
    "customDomain": "",
    "hashRouting": true
  },
  "defaultFile": "README.md",
  "home": {
    "title": "PMK.DEV",
    "subtitle": "A safe space for clankers and tokens",
    "background": {
      "enabled": false,
      "image": "",
      "grayscale": true
    }
  },
  "github": {
    "enabled": true,
    "owner": "petrikivimaki",
    "repo": "gh-pages-content",
    "branch": "master",
    "manifestPath": "manifest.json",
    "rootPath": "notes",
    "assetRootPath": "images"
  },
  "localFallback": {
    "enabled": false,
    "manifest": ""
  },
  "externalLinks": {
    "utm": {
      "enabled": true,
      "params": {
        "utm_source": "pmk.dev",
        "utm_medium": "referral",
        "utm_campaign": "knowledge-base"
      }
    }
  },
  "maps": {
    "enabled": true,
    "fallback": {
      "latitude": 60.17,
      "longitude": 24.94,
      "zoom": 11
    },
    "grayscale": true
  },
  "periodicTable": {
    "linkLabel": "PubChem",
    "linkTemplate": "https://pubchem.ncbi.nlm.nih.gov/element/{Z}"
  },
  "selectionMenu": {
    "searchProviders": [
      {
        "label": "Google",
        "icon": "fa-brands fa-google",
        "urlTemplate": "https://www.google.com/search?q={selection}"
      },
      {
        "label": "Brave",
        "icon": "fa-solid fa-magnifying-glass",
        "urlTemplate": "https://search.brave.com/search?q={selection}"
      }
    ]
  },
  "reading": {
    "wordsPerMinute": 225
  },
  "obsidian": {
    "vault": "Publisher",
    "rootPath": ""
  },
  "linktree": {
    "title": "",
    "subtitle": "",
    "groups": [
      {
        "cards": [
          {
            "label": "Helsinki",
            "timeZone": "Europe/Helsinki"
          }
        ]
      },
      {
        "cards": [
          {
            "label": "My GitHub",
            "description": "Clankers and tokens",
            "url": "https://github.com/petrikivimaki"
          },
          {
            "label": "Project repository",
            "description": "The source code for this website",
            "url": "https://github.com/petrikivimaki/papyrus"
          }
        ]
      }
    ]
  },
  "contentRights": {
    "copyright": "(c) 2026 Petri Mikael Kivimäki",
    "license": ""
  },
  "metadata": {
    "allowedKeys": [
      "title",
      "tags",
      "authors",
      "license",
      "copyright",
      "status"
    ]
  },
  "pageLoadAnimation": {
    "enabled": true,
    "backgroundColor": "rgb(0,0,0)",
    "logo": "images/papyrus-mark.png",
    "durationMs": 1500,
    "fadeMs": 420
  },
  "appearance": {
    "primaryMenuSide": "left",
    "contentWidth": 820,
    "fontFamily": "modern",
    "fontSize": 18,
    "textAlign": "left",
    "lineHeight": 1.68,
    "theme": "dark",
    "soundEnabled": true,
    "firstDayOfWeek": 1
  },
  "features": {
    "showFrontmatter": true,
    "showBacklinks": true,
    "showInsights": true
  }
